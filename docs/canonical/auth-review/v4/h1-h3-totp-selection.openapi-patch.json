[
  {
    "op": "add",
    "path": "/components/schemas/TotpMethodSelectionInput",
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totp_method_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid"
        },
        "grant_id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "enum": [
            "B1-SELF-04",
            "B1-SELF-05",
            "B1-SELF-06",
            "B1-SELF-08"
          ]
        },
        "resource_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "format": "uuid"
        }
      },
      "required": [
        "totp_method_id"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "grant_id"
            ],
            "properties": {
              "grant_id": {
                "const": "B1-SELF-08"
              }
            }
          },
          "then": {
            "required": [
              "resource_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "resource_id"
              ]
            }
          }
        }
      ]
    }
  },
  {
    "op": "add",
    "path": "/components/schemas/TotpSelectionRequired",
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "const": "TOTP_SELECTION_REQUIRED"
        },
        "methods": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "format": "uuid"
              },
              "kind": {
                "const": "TOTP"
              }
            },
            "required": [
              "method_id",
              "kind"
            ]
          }
        },
        "expires_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 35,
          "format": "date-time"
        }
      },
      "required": [
        "state",
        "methods",
        "expires_at"
      ]
    }
  },
  {
    "op": "replace",
    "path": "/components/schemas/loginResponse/properties/data",
    "value": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/AuthResult"
        },
        {
          "$ref": "#/components/schemas/TotpSelectionRequired"
        }
      ]
    }
  },
  {
    "op": "replace",
    "path": "/components/schemas/startStepUpResponse/properties/data",
    "value": {
      "oneOf": [
        {
          "$ref": "#/components/schemas/StepUpResult"
        },
        {
          "$ref": "#/components/schemas/TotpSelectionRequired"
        }
      ]
    }
  },
  {
    "op": "add",
    "path": "/paths/~1auth~1mfa~1totp~1select",
    "value": {
      "post": {
        "operationId": "selectTotpMethod",
        "summary": "REVIEW ONLY: select TOTP within resolved trusted context",
        "x-authentication-state": "ACTIVE_OR_PENDING_MFA",
        "x-rule": null,
        "x-rule-status": "DERIVED_SERVER_CONTEXT_AND_REVALIDATED_GRANT",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpMethodSelectionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed result; see HTTP_CONTRACT.md for state/cookie transitions",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "description": "Only transitions/revocation; Secure HttpOnly Path=/ SameSite=Lax; never Domain"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/StepUpResult"
                        },
                        {
                          "$ref": "#/components/schemas/PendingMfa"
                        }
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON, illegal selector or unknown query",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid/expired session or bound ceremony, generic",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Policy/CSRF/step-up denied",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Absent/invisible session; indistinguishable cross-tenant",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "State/replay/idempotency conflict or one-time result not replayable",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 16384 bytes",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not application/json for JSON input",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Safe input/domain validation error",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; Retry-After seconds, no account enumeration",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 900
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable; no downgrade",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "PreauthCookie": []
          },
          {
            "SessionCookie": []
          }
        ]
      }
    }
  }
]
