{
  "openapi": "3.1.0",
  "info": {
    "title": "CleanOps B2 tenant user profile and state",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/users/change": {
      "post": {
        "operationId": "changeAdministrationUser",
        "summary": "Audited existing-user profile/state changes; fresh B1 step-up, version CAS and owned one-time reservation",
        "x-authentication-state": "ACTIVE",
        "x-requirements": [
          "REQ-AUTHZ-006",
          "REQ-AUTHZ-007",
          "REQ-AUTH-047",
          "REQ-SCH-003",
          "REQ-AUD-001"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 43,
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/B2UserChangeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed audited change; self-disable clears the active session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2UserChangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale version, owned result not replayable or concurrent principal lock; refresh instead of blind retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe error without private identity or SQL details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "schemas": {
    "B2UserChangeInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "target_user_id",
            "expected_version",
            "reason",
            "display_name"
          ],
          "properties": {
            "operation": {
              "const": "EDIT"
            },
            "target_user_id": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            },
            "expected_version": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "target_user_id",
            "expected_version",
            "reason",
            "state"
          ],
          "properties": {
            "operation": {
              "const": "STATE"
            },
            "target_user_id": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            },
            "expected_version": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "state": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "DISABLED"
              ]
            }
          }
        }
      ]
    },
    "B2UserChangeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "changed",
            "user",
            "resource_version",
            "session_ended"
          ],
          "properties": {
            "changed": {
              "const": true
            },
            "user": {
              "$ref": "#/components/schemas/B2User"
            },
            "resource_version": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_ended": {
              "type": "boolean"
            }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id"
          ],
          "properties": {
            "correlation_id": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            }
          }
        }
      }
    }
  }
}
