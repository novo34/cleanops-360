{
  "openapi": "3.1.0",
  "info": {
    "title": "CleanOps B2 users directory",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/users": {
      "get": {
        "operationId": "listAdministrationUsers",
        "summary": "B2 tenant-scoped user directory; existing B1 effective_access policy",
        "x-authentication-state": "ACTIVE",
        "x-requirements": [
          "REQ-AUTHZ-005",
          "REQ-AUTHZ-006",
          "REQ-AUTHZ-007"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "DISABLED"
              ]
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Committed tenant-scoped read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2UsersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/users/detail": {
      "get": {
        "operationId": "getAdministrationUser",
        "summary": "B2 tenant-scoped user directory; existing B1 effective_access policy",
        "x-authentication-state": "ACTIVE",
        "x-requirements": [
          "REQ-AUTHZ-005",
          "REQ-AUTHZ-006",
          "REQ-AUTHZ-007"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "target_user_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Committed tenant-scoped read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/B2UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Safe error; no identity or SQL diagnostics",
            "content": {
