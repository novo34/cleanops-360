  "schemas": {
    "PasswordResetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket",
        "new_password"
      ],
      "properties": {
        "ticket": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "writeOnly": true
        },
        "recovery_code": {
          "type": "string",
          "minLength": 26,
          "maxLength": 26,
          "pattern": "^[A-Z2-7]{26}$",
          "writeOnly": true
        },
        "new_password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "writeOnly": true
        }
      }
    },
    "PasswordResetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "PASSWORD_RESET"
            }
          }
        },
        "meta": {
          "$ref": "#/components/schemas/Meta"
        }
      }
    },
    "AuthorizePasswordResetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_user_id",
        "ticket",
        "reason"
      ],
      "properties": {
        "target_user_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "ticket": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "writeOnly": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "AuthorizePasswordResetResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorized"
          ],
          "properties": {
            "authorized": {
              "const": true
            }
          }
        },
        "meta": {
          "$ref": "#/components/schemas/Meta"
        }
      }
    }
  }
