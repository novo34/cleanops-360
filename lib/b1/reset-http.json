          "REQ-AUTH-001",
          "REQ-AUTH-015",
          "REQ-AUTH-017",
          "REQ-AUTH-033",
          "REQ-AUTH-046",
          "REQ-AUD-001",
          "REQ-TEN-001",
          "REQ-TEN-002",
          "REQ-TEN-003",
          "REQ-TEN-004"
        ],
        "x-rule": null,
        "x-rule-status": "CEREMONY_NO_BUSINESS_GRANT",
        "x-authentication-state": "BOOTSTRAP_CSRF_AND_INDEPENDENT_RESET_PROOF",
