# Paths/names only. Populate privately after explicit deployment authorization.
CLEANOPS_AUTH_ORIGIN=https://cleanops.nuvurent.com
# Exact Next start -H 0.0.0.0 listener URLs and direct container HTTP authority.
CLEANOPS_AUTH_INTERNAL_ORIGINS='["http://0.0.0.0:3000","https://0.0.0.0:3000","http://127.0.0.1:3000"]'
# Installation inputs: copy observed names; do not create replacement resources.
CLEANOPS_COMPOSE_PROJECT=
CLEANOPS_PRIVATE_NETWORK=
# Confirmed existing staging volume; production supplies its own observed name.
CLEANOPS_PG_VOLUME=cleanops360_staging_pgdata
CLEANOPS_PG_IMAGE=
CLEANOPS_PG_DATABASE=
CLEANOPS_PG_BOOTSTRAP_USER=
CLEANOPS_PG_PASSWORD_FILE=
# PostgreSQL TLS: existing private files; no host directories are auto-created.
CLEANOPS_PG_TLS_CERT_FILE=
CLEANOPS_PG_TLS_KEY_FILE=
CLEANOPS_PG_TLS_CA_FILE=
CLEANOPS_PG_HBA_FILE=
# Exact SHOW hba_file result; mount at the same path to preserve relative includes.
CLEANOPS_PG_HBA_TARGET=
CLEANOPS_BAO_CONFIG_FILE=
CLEANOPS_BAO_TLS_DIR=
CLEANOPS_BAO_SUBNET=
CLEANOPS_BAO_PRIVATE_IPV4=
CLEANOPS_TRAEFIK_NETWORK=
CLEANOPS_TRAEFIK_ENTRYPOINT=
CLEANOPS_TRAEFIK_CERTRESOLVER=
# Keep blank until measured headroom + synthetic custody execution are authorized.
COMPOSE_PROFILES=
# Alternative verified prebuilt images, always name@sha256:digest (no latest).
CLEANOPS_STAGING_WEB_IMAGE=
CLEANOPS_STAGING_BAO_IMAGE=
# Official cert Agent: same mechanism in every environment; no token in env.
CLEANOPS_AGENT_IMAGE=
CLEANOPS_AGENT_NETWORK=
CLEANOPS_IDENTITY_UID=
CLEANOPS_IDENTITY_GID=
CLEANOPS_AGENT_CONFIG_FILE=
CLEANOPS_AGENT_TLS_DIR=
CLEANOPS_AGENT_CPUS=0.10
CLEANOPS_AGENT_MEMORY_LIMIT=128m
